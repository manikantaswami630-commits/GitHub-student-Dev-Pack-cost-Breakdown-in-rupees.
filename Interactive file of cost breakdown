</style>

<script>
const USD_TO_INR = 84;

// Category metadata
const catMeta = {
  dev:    { label: 'Dev Tools',       cls: 'sub-dev' },
  cloud:  { label: 'Cloud & Hosting', cls: 'sub-cloud' },
  learn:  { label: 'Learning',        cls: 'sub-learn' },
  infra:  { label: 'Infra & APIs',    cls: 'sub-infra' },
  domain: { label: 'Domains & SSL',   cls: 'sub-domain' },
  sec:    { label: 'Security',        cls: 'sub-sec' },
  prod:   { label: 'Productivity',    cls: 'sub-prod' },
};

// Extract USD value from a row's .price-usd cell text
function getUSD(row) {
  const cell = row.querySelector('.price-usd');
  if (!cell) return 0;
  return parseFloat(cell.textContent.replace(/[^0-9.]/g, '')) || 0;
}

function formatINR(n) {
  // Indian numbering: e.g. 1,19,316
  const s = Math.round(n).toString();
  if (s.length <= 3) return '₹' + s;
  const last3 = s.slice(-3);
  const rest = s.slice(0, -3);
  const grouped = rest.replace(/\B(?=(\d{2})+(?!\d))/g, ',');
  return '₹' + grouped + ',' + last3;
}

function rebuildFoot(activeFilter) {
  const foot = document.getElementById('tableFoot');
  foot.innerHTML = '';

  const allRows = Array.from(document.querySelectorAll('#priceTable tbody tr[data-cat]'));

  // Collect visible rows per category
  const catOrder = ['dev', 'cloud', 'learn', 'infra', 'domain', 'sec', 'prod'];
  let grandUSD = 0;
  let grandCount = 0;

  catOrder.forEach(cat => {
    const rows = allRows.filter(r => r.dataset.cat === cat && r.style.display !== 'none');
    if (rows.length === 0) return;

    const catUSD = rows.reduce((sum, r) => sum + getUSD(r), 0);
    const catINR = catUSD * USD_TO_INR;
    grandUSD += catUSD;
    grandCount += rows.length;

    const meta = catMeta[cat];
    const tr = document.createElement('tr');
    tr.className = 'subtotal-row';
    tr.innerHTML = `
      <td colspan="4" class="sub-label">
        <span class="${meta.cls}">${meta.label}</span>
        <span class="sub-count">${rows.length} tool${rows.length > 1 ? 's' : ''}</span>
      </td>
      <td class="sub-usd">$${catUSD.toLocaleString()}</td>
      <td class="sub-inr ${meta.cls}">${formatINR(catINR)}</td>
    `;
    foot.appendChild(tr);
  });

  // Grand total row
  const grandINR = grandUSD * USD_TO_INR;
  const gtRow = document.createElement('tr');
  gtRow.className = 'grand-total';
  gtRow.innerHTML = `
    <td colspan="4" class="grand-label">Grand Total · ${grandCount} tools</td>
    <td class="grand-usd">$${grandUSD.toLocaleString()} USD</td>
    <td class="grand-inr">${formatINR(grandINR)}</td>
  `;
  foot.appendChild(gtRow);
}

function filterTable(cat, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  const rows = document.querySelectorAll('#priceTable tbody tr[data-cat]');
  const headers = document.querySelectorAll('#priceTable tbody tr.category-header');

  rows.forEach(row => {
    row.style.display = (cat === 'all' || row.dataset.cat === cat) ? '' : 'none';
  });

  headers.forEach(header => {
    let next = header.nextElementSibling;
    let hasVisible = false;
    while (next && !next.classList.contains('category-header')) {
      if (next.style.display !== 'none') { hasVisible = true; break; }
      next = next.nextElementSibling;
    }
    header.style.display = hasVisible ? '' : 'none';
  });

  rebuildFoot(cat);
}

// Build on load
rebuildFoot('all');
</script>

