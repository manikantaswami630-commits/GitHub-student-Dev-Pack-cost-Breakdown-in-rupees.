<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>GitHub Student Pack — Price Breakdown</title>
<style>
  :root {
    --bg: #0D1117;
    --surface: #161B22;
    --surface2: #1C2128;
    --border: #30363D;
    --border-subtle: #21262D;
    --text: #E6EDF3;
    --text-muted: #8B949E;
    --text-dim: #6E7681;
    --blue: #58A6FF;
    --green: #3FB950;
    --yellow: #D29922;
    --purple: #BC8CFF;
    --orange: #F0883E;
    --red: #FF7B72;
    --pink: #FF6EB3;
    --teal: #39D353;
    --mono: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.5;
    padding: 32px 24px;
    min-height: 100vh;
  }

  .header {
    margin-bottom: 28px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .header-left h1 {
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .header-left p {
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 4px;
  }

  .header-right {
    text-align: right;
  }

  .total-badge {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 18px;
    display: inline-block;
  }

  .total-badge .label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }

  .total-badge .amount {
    font-family: var(--mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--green);
  }

  .total-badge .sub {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: 2px;
  }

  .note-bar {
    background: #161B22;
    border: 1px solid #30363D;
    border-left: 3px solid var(--yellow);
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .note-bar strong { color: var(--yellow); }

  .filter-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    align-items: center;
  }

  .filter-label {
    font-size: 12px;
    color: var(--text-dim);
    margin-right: 4px;
  }

  .filter-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 12px;
    padding: 4px 10px;
    cursor: pointer;
    font-family: var(--sans);
    transition: all 0.15s;
  }

  .filter-btn:hover, .filter-btn.active {
    border-color: var(--blue);
    color: var(--blue);
    background: rgba(88,166,255,0.08);
  }

  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead {
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  thead th {
    padding: 10px 14px;
    text-align: left;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.4px;
    white-space: nowrap;
  }

  thead th.num { text-align: right; }

  tbody tr {
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.1s;
  }

  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: rgba(255,255,255,0.025); }

  tbody tr.category-header {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  tbody tr.category-header td {
    padding: 8px 14px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-dim);
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  td {
    padding: 10px 14px;
    vertical-align: middle;
  }

  .tool-name {
    font-weight: 500;
    color: var(--text);
    font-size: 13px;
  }

  .tool-detail {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: 2px;
  }

  .badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 20px;
    letter-spacing: 0.3px;
  }

  .badge-dev    { background: rgba(88,166,255,0.15);  color: var(--blue);   border: 1px solid rgba(88,166,255,0.3); }
  .badge-cloud  { background: rgba(240,136,62,0.15);  color: var(--orange); border: 1px solid rgba(240,136,62,0.3); }
  .badge-learn  { background: rgba(188,140,255,0.15); color: var(--purple); border: 1px solid rgba(188,140,255,0.3); }
  .badge-infra  { background: rgba(63,185,80,0.15);   color: var(--green);  border: 1px solid rgba(63,185,80,0.3); }
  .badge-domain { background: rgba(210,153,34,0.15);  color: var(--yellow); border: 1px solid rgba(210,153,34,0.3); }
  .badge-sec    { background: rgba(255,123,114,0.15); color: var(--red);    border: 1px solid rgba(255,123,114,0.3); }
  .badge-prod   { background: rgba(57,211,83,0.15);   color: var(--teal);   border: 1px solid rgba(57,211,83,0.3); }

  .offer-text {
    font-size: 12px;
    color: var(--text-muted);
    max-width: 220px;
  }

  .duration {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .duration.long { color: var(--green); }
  .duration.short { color: var(--yellow); }
  .duration.onetime { color: var(--purple); }

  .price-usd {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-dim);
    text-align: right;
    white-space: nowrap;
  }

  .price-inr {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    text-align: right;
    white-space: nowrap;
  }

  .price-inr.high { color: var(--orange); }
  .price-inr.very-high { color: var(--red); }

  tfoot tr {
    background: var(--bg);
    border-top: 2px solid var(--border);
  }

  tfoot td {
    padding: 14px 14px;
    font-weight: 700;
  }

  .total-label {
    font-size: 14px;
    color: var(--text);
  }

  .total-usd {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-muted);
    text-align: right;
  }

  .total-inr {
    font-family: var(--mono);
    font-size: 18px;
    color: var(--green);
    text-align: right;
    font-weight: 700;
  }

  .legend {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--text-dim);
  }

  .legend-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
  }

  .exchange-note {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: 12px;
  }

  .exchange-note span {
    font-family: var(--mono);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    body { padding: 16px 12px; }
    .price-usd { display: none; }
    td { padding: 8px 10px; }
    thead th { padding: 8px 10px; }
    .offer-text { max-width: 140px; font-size: 11px; }
  }
</style>
</head>
